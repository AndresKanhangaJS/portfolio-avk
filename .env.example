# URL público do site (Vercel define isto por projecto).
# Hoje: https://<projecto>.vercel.app  |  Amanhã: https://andrekanhanga.dev
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Chave da API do Resend, para o formulário de contacto.
# Cria em https://resend.com/api-keys
RESEND_API_KEY=

# Opcional. Só depois de verificares um domínio próprio no Resend.
# Sem isto, o remetente é onboarding@resend.dev
# CONTACT_FROM_EMAIL=Portfolio <contacto@andrekanhanga.dev>

# Opcional: Google Analytics
NEXT_PUBLIC_GA_ID=
